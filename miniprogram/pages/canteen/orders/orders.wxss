/* pages/canteen/orders/orders.wxss */
.tabs {
  display: flex;
  background: #fff;
  height: 88rpx;
  line-height: 88rpx;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
}

.tab.active {
  color: #007AFF;
  font-weight: bold;
  border-bottom: 4rpx solid #007AFF;
}

.card {
  background: #fff;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.order-id { font-weight: bold; }
.time { color: #999; font-size: 24rpx; }

.items {
  padding: 10rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
  margin: 10rpx 0;
}

.dish {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.total {
  font-weight: bold;
  justify-content: flex-end;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn-action {
  background: #007AFF;
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  margin: 0;
}
