/* pages/canteen/dashboard/dashboard.wxss */
.header-bar {
  padding: 30rpx;
  background: #007AFF;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.8;
}

.card {
  margin: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #007AFF;
  padding-left: 20rpx;
}

.chart-container {
  height: 400rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

.prediction-list {
  display: flex;
  justify-content: space-around;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
}

.pred-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.val {
  font-size: 32rpx;
  font-weight: bold;
  color: #007AFF;
}

/* Cluster */
.cluster-item {
  margin-bottom: 30rpx;
}

.cluster-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.topic {
  font-weight: bold;
  font-size: 28rpx;
}

.ratio {
  color: #ff4d4f;
  font-size: 24rpx;
}

.example-box {
  background: #fff1f0;
  padding: 16rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.example-label {
  color: #ff4d4f;
  font-weight: bold;
}

/* Actions */
.action-grid {
  display: flex;
  padding: 0 30rpx;
  justify-content: space-between;
}

.action-btn {
  width: 48%;
  background: #fff;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  background: #eee;
  margin-bottom: 20rpx;
}
