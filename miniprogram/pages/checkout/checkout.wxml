<!-- pages/checkout/checkout.wxml -->
<view class="container">
  <view class="section-title">订单详情</view>
  
  <view class="order-list">
    <block wx:for="{{cart}}" wx:key="dishId">
      <view class="order-item">
        <text class="name">{{item.name}}</text>
        <text class="count">x{{item.count}}</text>
        <text class="price">¥{{item.price * item.count}}</text>
      </view>
    </block>
  </view>

  <view class="total-row">
    <text>合计</text>
    <text class="total-price">¥{{totalPrice}}</text>
  </view>

  <view class="pay-btn-area">
    <button class="btn-primary" bindtap="handlePay">确认支付</button>
  </view>
</view>
