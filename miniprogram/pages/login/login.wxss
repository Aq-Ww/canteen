/* pages/login/login.wxss */
.container {
  background-color: #f0f2f5;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.header {
  margin-bottom: 60rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
}

.form-card {
  width: 100%;
  background: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.role-group {
  margin-bottom: 40rpx;
}

.radio-group {
  display: flex;
  justify-content: space-around;
}

.radio {
  font-size: 30rpx;
}
