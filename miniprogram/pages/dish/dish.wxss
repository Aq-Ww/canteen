/* pages/dish/dish.wxss */
.dish-banner {
  width: 100%;
  height: 400rpx;
  background: #eee;
}

.info-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
}

.price {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.meta {
  font-size: 24rpx;
  color: #999;
}

.meta text {
  margin-right: 20rpx;
}

.review-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 120rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.review-item {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.user-name {
  color: #333;
  font-weight: bold;
}

.review-score {
  color: #ff9800;
}

.review-content {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.review-date {
  font-size: 22rpx;
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-cart {
  width: 90%;
  height: 80rpx;
  background: #007AFF;
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
