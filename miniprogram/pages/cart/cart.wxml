<!-- pages/cart/cart.wxml -->
<view class="container">
  <view class="empty-tip" wx:if="{{cart.length === 0}}">
    <image src="/images/empty_cart.png" class="empty-img" mode="aspectFit"></image>
    <text>购物车空空如也</text>
    <button class="btn-go" bindtap="goHome">去点餐</button>
  </view>

  <view class="cart-list" wx:else>
    <block wx:for="{{cart}}" wx:key="dishId">
      <view class="cart-item">
        <image class="item-img" src="{{item.image || '/images/default_dish.png'}}" mode="aspectFill"></image>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-shop">{{item.shopName}}</text>
          <view class="price-row">
            <text class="price">¥{{item.price}}</text>
            <view class="stepper">
              <view class="btn-minus" catchtap="updateCount" data-index="{{index}}" data-op="-">-</view>
              <text class="count">{{item.count}}</text>
              <view class="btn-plus" catchtap="updateCount" data-index="{{index}}" data-op="+">+</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="footer-bar" wx:if="{{cart.length > 0}}">
    <view class="total-section">
      <text>合计：</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <view class="btn-settle" bindtap="goCheckout">去结算 ({{totalCount}})</view>
  </view>
</view>
