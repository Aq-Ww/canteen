/* pages/my_reviews/my_reviews.wxss */
.review-card {
  background: #fff;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 12rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.shop-name {
  font-weight: bold;
}

.date {
  color: #999;
  font-size: 24rpx;
}

.score {
  color: #ff9800;
  margin-bottom: 10rpx;
}

.content {
  color: #666;
}
