/* pages/home/home.wxss */
.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 20rpx 0;
}

.section-title {
  padding: 0 30rpx 20rpx;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: baseline;
}

.section-title .subtitle {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
  font-weight: normal;
}

/* Recommend Scroll */
.recommend-scroll {
  display: flex;
  padding: 0 20rpx;
  height: 320rpx; 
  /* enable-flex requires explicit height or display settings usually */
}

.recommend-item {
  flex-shrink: 0;
  width: 240rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.rec-img {
  width: 100%;
  height: 180rpx;
  background-color: #eee;
}

.rec-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.rec-name {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rec-price {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-top: 8rpx;
}

/* Shop List */
.shop-list {
  padding: 0 30rpx;
}

.shop-card {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.shop-card:last-child {
  border-bottom: none;
}

.shop-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background-color: #eee;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.shop-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
}

.shop-score {
  color: #ff9800;
  font-weight: bold;
  font-size: 28rpx;
}

.shop-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0;
}
